{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "unchanged",
              "repaired",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "text",
                        "romanization",
                        "notes"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "senseKey"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "partOfSpeech"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "enum": [
                        "noun",
                        "verb",
                        "adjective",
                        "adverb",
                        "pronoun",
                        "determiner",
                        "preposition",
                        "postposition",
                        "conjunction",
                        "particle",
                        "interjection",
                        "numeral",
                        "expression",
                        "other",
                        "counter",
                        "classifier"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "reading"
                      ]
                    },
                    "value": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "array",
                        "items": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "example"
                      ]
                    },
                    "value": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "pattern": "\\S"
                        },
                        "reading": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "items": [
                              {
                                "type": "string",
                                "minLength": 1
                              },
                              {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "\\S"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2
                          }
                        },
                        "romanization": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "pattern": "\\S"
                        },
                        "translation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "text",
                        "translation"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "dropSourceIndexes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "handle",
          "status",
          "changes",
          "dropSourceIndexes"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "repaired"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              }
            },
            "else": {
              "properties": {
                "changes": {
                  "maxItems": 0
                },
                "dropSourceIndexes": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
