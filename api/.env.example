# Copy to .env (gitignored) and fill in. `npm run dev` loads it, then .env.local.
# Never commit real keys or put them in Vite variables.

# Local development without Firebase: no identity, App Check or ledger. Only the development
# launcher accepts this value; the deployed service and deploy.sh reject it.
PROTECTION_ENV=local

# Vertex AI (Gemini): translation, setup, titles, breakdowns and the rate-limit fallback.
# Also needs `gcloud auth application-default login`.
GCP_PROJECT_ID=
GCP_VERTEX_LOCATION=global

# OpenRouter: English generation and cover images.
OPENROUTER_API_KEY=

# Only for LLM_BACKEND=claude or LLM_BACKEND=chatgpt.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
