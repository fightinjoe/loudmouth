{
  "name": "src",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run schema:build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "npm run schema:build",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "schema:build": "tsc -p ../../api/src/schema/tsconfig.json",
    "typecheck": "npm run schema:build && tsc --noEmit",
    "prestorybook": "npm run schema:build",
    "storybook": "storybook dev --host 0.0.0.0 --port 6006 --exact-port",
    "build-storybook": "npm run typecheck && storybook build",
    "test:storybook": "playwright test --config playwright.storybook.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/html-vite": "10.6.5",
    "@types/node": "25.9.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@catchphrase/card-schema": "file:../../api/src/schema",
    "dexie": "^4.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents": false
  }
}
