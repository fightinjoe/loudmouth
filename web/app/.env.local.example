# Copy to .env.local (gitignored). Local library use needs no online configuration.
# Leave every Firebase/reCAPTCHA value blank to call a local API that runs with PROTECTION_ENV=local:
# the development server then sends no credentials. Set all five, from the separate registered
# nonproduction app, to exercise real verification. A production build always requires all six inputs.
# Never copy a debug token or production credentials into this checked-in file.
VITE_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
